<h1 id="welcome">loading...</h1>
<p id="email"></p>
<p id="slack"></p>

<script>
  const params = new URLSearchParams(window.location.search);
  const token = params.get('token') || localStorage.getItem('token');

  if (params.get('token')) {
    localStorage.setItem('token', params.get('token'));
    window.history.replaceState({}, '', '/dash');
  }
  const res = await fetch(`/api/auth/me?token=${token}`);
  const user = await res.json();

  document.getElementById('welcome').textContent = `Welcome, ${user.name}!`;
  document.getElementById('email').textContent = `your email is ${user.email}`;
  document.getElementById('slack').textContent = `your slack id is ${user.slack_id}`;
</script>