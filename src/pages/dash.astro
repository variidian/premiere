---
import '../../src/styles/global.css'
import '../../src/styles/platform.css'
import UserBar from '../components/user.astro' 
---
<link rel="stylesheet" href="https://unpkg.com/easymde/dist/easymde.min.css">
<script src="https://unpkg.com/easymde/dist/easymde.min.js"></script>

<body class="bg-[url(/bg.png)] bg-fixed bg-center bg-no-repeat bg-cover mb-15">

  <!--navbar -->
    <div class=" left-0 top-0 fixed">
        <img src="navbar_.png" class="h-screen">
        <img src="stick.png" class="h-screen absolute top-0 left-1/2 -translate-x-1/2 z-[9] ">
        <div class="z-10 absolute top-0 left-0 right-0">
            <a href="/dash">
            <img src="home_l.png" class="min-w-full lift">
        </a>
            <a href="/projects">
            <img src="projects_d.png" class="min-w-full lift">
            </a>
            <a href="/gallery">
            <img src="gallery_d.png" class="min-w-full lift">
            </a>
            <a href="/shop">
            <img src="shop_d.png" class="min-w-full lift">
            </a>
        </div>
    </div>

<UserBar></UserBar>

<div class=" ml-[58.9vh] p-20 text-center max-w-full">
<div class="overflow-hidden">
<img src="premiere_banner.png" class="rounded-xl transition duration-500 hover:scale-130">
</div>
<div class="p-5 bg-[#fb4bb0] rounded-xl mt-10">
<textarea class="w-full focus:outline-none" id="publish-devlog" name='publish-devlog' placeholder="what have you made today? (hey - this textbox has markdown support!)"></textarea>
  <div class="flex flex-row items-start gap-3">

    <div class="dropdown relative inline">
      <button class="dropbtn rounded-xl p-2 bg-[#ff78cd]" id="selected-project" type="button">choose project</button>
      <div class="dropdown-content hidden flex flex-col absolute z-10 bg-[#ff78cd] mt-2 p-2 w-sm rounded-xl" id="project-menu">
        <a href="/projects">create a project first</a>
      </div>
    </div>

    <button class="rounded-xl p-2 bg-[#ff78cd]" id="publish-btn" type="button">publish!</button>
    </div>
    <p id="publish-status" class="mt-3"></p>
</div>

<div class="mt-10 p-5 bg-[#fb4bb0] rounded-xl">
  <h2>Recent devlogs</h2>
  <div id="devlog-feed" class="flex flex-col gap-4 mt-4"></div>
</div>

</div>
</body>

<script>
import { API, requireAuth } from '../scripts/auth.js';

const btn = document.querySelector('.dropbtn');
const menu = document.querySelector('.dropdown-content');
const projectButton = document.getElementById('selected-project');
const publishButton = document.getElementById('publish-btn');
const publishStatus = document.getElementById('publish-status');
const devlogFeed = document.getElementById('devlog-feed');
let selectedProject = null;

btn?.addEventListener("click", showdropdown);
function showdropdown() {
  menu.classList.toggle('hidden');
}

//markdown support for editing da devlog
const easyMDE = new EasyMDE({
  element: document.getElementById('publish-devlog'),
  spellChecker: false,
  minHeight: "100px"
});

function escapeHtml(value = '') {
  return value.replace(/[&<>"']/g, (char) => ({
    '&': '&amp;',
    '<': '&lt;',
    '>': '&gt;',
    '"': '&quot;',
    "'": '&#39;'
  }[char]));
}

async function loadProjects() {
  const token = localStorage.getItem('token');
  const res = await fetch(`${API}/projects?token=${encodeURIComponent(token)}`);
  const projects = await res.json();
  menu.innerHTML = '';

  if (!projects.length) {
    menu.innerHTML = '<a href="/projects">create a project first</a>';
    return;
  }

  projects.forEach((project) => {
    const item = document.createElement('button');
    item.type = 'button';
    item.className = 'text-left p-2 rounded-lg hover:bg-[#fb4bb0]';
    item.textContent = `${project.name} (${project.hackatime_project})`;
    item.addEventListener('click', () => {
      selectedProject = project;
      projectButton.textContent = project.name;
      menu.classList.add('hidden');
    });
    menu.appendChild(item);
  });

  selectedProject = projects[0];
  projectButton.textContent = projects[0].name;
}

async function loadDevlogs() {
  const res = await fetch(`${API}/devlogs`);
  const devlogs = await res.json();
  devlogFeed.innerHTML = devlogs.map((devlog) => `
    <article class="bg-[#ff78cd] rounded-xl p-4">
      <div class="flex items-center gap-3 mb-3">
        ${devlog.author.avatar ? `<img src="${devlog.author.avatar}" class="w-10 h-10 rounded-full">` : ''}
        <p>${escapeHtml(devlog.author.display_name || 'Premiere maker')}</p>
      </div>
      ${devlog.project ? `<p><b>${escapeHtml(devlog.project.name)}</b> - Hackatime: ${escapeHtml(devlog.project.hackatime_project)}</p>` : ''}
      <p>${escapeHtml(devlog.content).replace(/\n/g, '<br>')}</p>
    </article>
  `).join('');
}

//publishing / creating new devlogs
async function publish_log() {
  const token = localStorage.getItem('token');
  if (!token) return null;
  if (!selectedProject) {
    publishStatus.textContent = 'Choose or create a project before publishing.';
    return;
  }

  const res = await fetch(`${API}/devlogs`, {
    method: 'POST',
    headers: { //indicates its formatted as json
      'Content-Type': 'application/json',
      'X-User-Token': token
    },
    body: JSON.stringify({ 
      token: token,
      project_id: selectedProject.id,
      content: easyMDE.value()
    })
  });
  const data = await res.json();

  if (!res.ok) {
    publishStatus.textContent = data.errors?.join(', ') || data.error || 'Could not publish devlog.';
    return;
  }

  easyMDE.value('');
  publishStatus.textContent = 'Published!';
  await loadDevlogs();
}
publishButton.addEventListener('click', publish_log);

// save token 
const params = new URLSearchParams(window.location.search);
if (params.get('token')) {
  localStorage.setItem('token', params.get('token'));
  window.history.replaceState({}, '', '/dash');
}
const user = await requireAuth();
document.getElementById('pfp').src = user.avatar;
document.getElementById('username').textContent = `@${user.display_name}`;
document.getElementById('clapperboards').textContent = `${user.clapperboards}`;
await loadProjects();
await loadDevlogs();
</script>
