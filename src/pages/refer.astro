---
import '../../src/styles/global.css'
import '../../src/styles/platform.css'
import UserBar from '../components/user.astro'
---
<body class="bg-[url(bg.png)] bg-fixed bg-center bg-no-repeat bg-cover ">
<!--navbar -->
    <div class=" left-0 top-0 fixed">
        <img src="navbar_.png" class="h-screen">
        <img src="stick.png" class="h-screen absolute top-0 left-1/2 -translate-x-1/2 z-[9] ">
        <div class="z-10 absolute top-0 left-0 right-0">
            <a href="/dash">
            <img src="home_d.png" class="min-w-full lift">
        </a>
            <a href="/projects">
            <img src="projects_d.png" class="min-w-full lift">
            </a>
            <a href="/gallery">
            <img src="gallery_d.png" class="min-w-full lift">
            </a>
            <a href="/shop">
            <img src="shop_d.png" class="min-w-full lift">
            </a>
            <a href="/refer">
            <img src="refer_l.png" class="min-w-full lift">
            </a>
        </div>
    </div>

<UserBar></UserBar>

<div class=" ml-[58.9vh] p-20 text-center max-w-full">
<div class="overflow-hidden">
</div>
<h1>Invite your friends!</h1>
<p class="pb-5">For every person that joins Premiere through your link, you'll earn a (currency_name) to spend in the shop!</p>
<p id="referrals">.</p>
<div class="bg-[#ff78cd] w-full rounded-3xl lift mt-10 pb-8">
<h2 class="pl-5 pt-5">Your link is...</h2>

<div class="flex flex-row">

<div class="bg-[#ffc1e8] w-6/7 rounded-2xl ml-5 border-3 border-[#151767] border-dashed">
<p class="pl-5 pt-2 !text-[#151767] truncate" id="referralUrl">link here</p>
</div>

</div>


</div>
</div>
</div>
</body>

<script>
  import { requireAuth } from '../scripts/auth.js';

  const user = await requireAuth();
  document.getElementById('referralUrl').textContent = `https://premiere-ysws.vercel.app/?r=${user.slack_id}`;
  
  document.getElementById('referrals').textContent = `You've referred ${user.referrals} people`;
</script>