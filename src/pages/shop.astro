---
import '../../src/styles/global.css'
import '../../src/styles/platform.css'
import UserBar from '../components/user.astro'
---
<body class="bg-[url(/bg.png)] bg-fixed bg-center bg-no-repeat bg-cover ">
<div class=" left-0 top-0 fixed">
    <img src="navbar_.png" class="h-screen">
    <img src="stick.png" class="h-screen absolute top-0 left-1/2 -translate-x-1/2 z-[9] ">
    <div class="z-10 absolute top-0 left-0 right-0">
        <a href="/dash"><img src="home_d.png" class="min-w-full lift"></a>
        <a href="/projects"><img src="projects_d.png" class="min-w-full lift"></a>
        <a href="/gallery"><img src="gallery_d.png" class="min-w-full lift"></a>
        <a href="/shop"><img src="shop_l.png" class="min-w-full lift"></a>
    </div>
</div>

<UserBar></UserBar>
<div class=" ml-[58.9vh] p-20 text-center max-w-full">
  <div class="overflow-hidden">
    <h1>Spend, Spend, Spend</h1>
    <p>get some prizes!</p>
  </div>

  <div id="shop-grid" class="grid grid-cols-2 gap-6 mt-10"></div>
</div>
</body>

<script>
  import { API, requireAuth } from '../scripts/auth.js';

  const items = [
    { id: 'sticker-pack', name: 'stickers!!', price: 3, image: '/card1.png', text: 'A tiny bundle of placeholder stickers.' },
    { id: 'keychain', name: 'Tiny Clapperboard Keychain', price: 8, image: '/card2.png', text: 'Placeholder prize copy for a neat little keychain.' },
    { id: 'poster', name: 'Premiere Poster', price: 12, image: '/card3.png', text: 'Placeholder wall art for Premiere projects.' },
    { id: 'mystery-box', name: 'Mystery Prize Box', price: 20, image: '/card4.png', text: 'A placeholder mystery prize with dramatic suspense.' }
  ];
  const grid = document.getElementById('shop-grid');

  async function buyItem(item) {
    if (!confirm(`Buy ${item.name} for ${item.price} clapperboards?`)) return;

    const token = localStorage.getItem('token');
    const res = await fetch(`${API}/shop/purchase`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-User-Token': token
      },
      body: JSON.stringify({ token, item_id: item.id })
    });
    const data = await res.json();
    if (!res.ok) {
      alert(data.error || 'Could not buy item.');
      return;
    }

    document.getElementById('clapperboards').textContent = `${data.clapperboards}`;
    alert(`Bought ${item.name}!`);
  }

  function renderItems() {
    grid.innerHTML = '';
    items.forEach((item) => {
      const article = document.createElement('article');
      article.className = 'bg-[#fb4bb0] rounded-xl p-5 lift';
      article.innerHTML = `
        <img src="${item.image}" class="w-full aspect-video object-cover rounded-xl mb-4">
        <h2>${item.name}</h2>
        <p>${item.text}</p>
        <p>${item.price} clapperboards</p>
        <button class="rounded-xl p-3 bg-[#ff78cd]" type="button">buy</button>
      `;
      article.querySelector('button').addEventListener('click', () => buyItem(item));
      grid.appendChild(article);
    });
  }

  await requireAuth();
  renderItems();
</script>
