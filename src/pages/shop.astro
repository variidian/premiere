<!--navbar -->
    <div class=" left-0 top-0 fixed">
        <img src="navbar_.png" class="h-screen">
        <img src="stick.png" class="h-screen absolute top-0 left-1/2 -translate-x-1/2 z-[9] ">
        <div class="z-10 absolute top-0 left-0 right-0">
            <a href="/dash">
            <img src="home_d.png" class="min-w-full lift">
        </a>
            <a href="/projects">
