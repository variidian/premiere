            <a href="/gallery">
            <img src="gallery_d.png" class="min-w-full lift">
            </a>
            <a href="/shop">
            <img src="shop_l.png" class="min-w-full lift">
            </a>
            <a href="/refer">
            <img src="refer_d.png" class="min-w-full lift">
            </a>
        </div>
    </div>

<UserBar></UserBar>
<div class=" ml-[58.9vh] p-20 text-center max-w-full">
