---
import '../../src/styles/global.css'
import '../../src/styles/platform.css'
import UserBar from '../components/user.astro'
---
<body class="bg-[url(/bg.png)] bg-fixed bg-center bg-no-repeat bg-cover ">
<div class=" left-0 top-0 fixed">
    <img src="navbar_.png" class="h-screen">
    <img src="stick.png" class="h-screen absolute top-0 left-1/2 -translate-x-1/2 z-[9] ">
    <div class="z-10 absolute top-0 left-0 right-0">
        <a href="/dash"><img src="home_d.png" class="min-w-full lift"></a>
        <a href="/projects"><img src="projects_l.png" class="min-w-full lift"></a>
        <a href="/gallery"><img src="gallery_d.png" class="min-w-full lift"></a>
        <a href="/shop"><img src="shop_d.png" class="min-w-full lift"></a>
        <a href="/refer"><img src="refer_d.png" class="min-w-full lift"></a>
    </div>
</div>

<UserBar></UserBar>
<div class=" ml-[58.9vh] p-20 text-center max-w-full">
  <div class="overflow-hidden">
    <h1>Make something cool!</h1>
    <p>The hours you spend working on your project will count towards getting prizes :)</p>
  </div>

  <a href="/projects/new" class="block bg-[#fb4bb0] rounded-xl p-5 mt-10 lift no-underline">
    <h2>Create a project</h2>
    <p>Start with a name and description, then add shipping details when you are ready.</p>
  </a>

  <div class="bg-[#fb4bb0] rounded-xl p-5 mt-10">
    <h2>Your projects</h2>
    <div id="project-list" class="grid grid-cols-2 gap-4 mt-4"></div>
  </div>
</div>
</body>

<script>
  import { API, requireAuth } from '../scripts/auth.js';

  const FILLOUT_FORM_URL = import.meta.env.PUBLIC_FILLOUT_FORM_URL || 'https://forms.fillout.com/t/premiere-project-submission';
  const projectList = document.getElementById('project-list');
  let user = null;
  let hackatimeProjects = [];
  let hackatimeConnected = false;

  function escapeHtml(value = '') {
    return String(value).replace(/[&<>"']/g, (char) => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#39;'
    }[char]));
  }

  function statusLabel(status) {
    return {
      not_yet_shipped: 'not yet shipped',
      pending_approval: 'pending approval',
      approved: 'approved',
      rejected: 'rejected'
    }[status] || status;
  }

  function missingShipFields(project) {
    return ['repository_url', 'demo_url', 'image_url', 'hackatime_project', 'hackatime_hours']
      .filter((field) => !project[field]);
  }

  function filloutUrl(project) {
    const url = new URL(FILLOUT_FORM_URL);
    url.searchParams.set('name', user.name || '');
    url.searchParams.set('email', user.email || '');
    url.searchParams.set('slack_id', user.slack_id || '');
    url.searchParams.set('display_name', user.display_name || '');
    url.searchParams.set('project_name', project.name || '');
    url.searchParams.set('description', project.description || '');
    url.searchParams.set('hackatime_project', project.hackatime_project || '');
    url.searchParams.set('hackatime_hours', project.hackatime_hours || '');
    url.searchParams.set('repository_url', project.repository_url || '');
    url.searchParams.set('demo_url', project.demo_url || '');
    url.searchParams.set('image_url', project.image_url || '');
    return url.toString();
  }

  function hackatimeOptionLabel(project) {
    return project.hours ? `${project.name} - ${project.hours} hours` : project.name;
  }

  async function loadHackatimeProjects() {
    const token = localStorage.getItem('token');
    const res = await fetch(`${API}/hackatime/projects?token=${encodeURIComponent(token)}`, {
      headers: { 'X-User-Token': token }
    });

    if (!res.ok) {
      hackatimeProjects = [];
      hackatimeConnected = false;
      return;
    }

    const data = await res.json();
    hackatimeConnected = !!data.connected;
    hackatimeProjects = data.projects || [];
  }

  async function saveProject(id, payload) {
    const token = localStorage.getItem('token');
    const res = await fetch(`${API}/projects/${id}`, {
      method: 'PATCH',
      headers: {
        'Content-Type': 'application/json',
        'X-User-Token': token
      },
      body: JSON.stringify({ token, ...payload })
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.errors?.join(', ') || data.error || 'Could not save project.');
    return data;
  }

  async function markPending(project) {
    const missing = missingShipFields(project);
    if (missing.length) {
      throw new Error(`Add these before shipping: ${missing.map((field) => field.replaceAll('_', ' ')).join(', ')}`);
    }

    const data = await saveProject(project.id, { status: 'pending_approval' });
    window.open(filloutUrl(data), '_blank', 'noopener,noreferrer');
    await loadProjects();
  }

  function projectCard(project) {
    const missing = missingShipFields(project);
    return `
      ${project.image_url ? `<img src="${escapeHtml(project.image_url)}" class="w-full aspect-video object-cover rounded-xl mb-3">` : ''}
      <h2>${escapeHtml(project.name)}</h2>
      <p>Status: ${escapeHtml(statusLabel(project.status))}</p>
      <p>${escapeHtml(project.description || '')}</p>
      ${project.hackatime_project ? `<p>Hackatime: ${escapeHtml(project.hackatime_project)}${project.hackatime_hours ? ` (${escapeHtml(project.hackatime_hours)}h)` : ''}</p>` : ''}
      ${missing.length ? `<p>Missing to ship: ${missing.map((field) => field.replaceAll('_', ' ')).join(', ')}</p>` : ''}
    `;
  }

  function editForm(project) {
    return `
      <form class="project-edit flex flex-col gap-3" data-project-id="${project.id}">
        <input class="rounded-xl p-3 bg-[#fb4bb0]" name="name" value="${escapeHtml(project.name)}" placeholder="project name" required>
        <textarea class="rounded-xl p-3 bg-[#fb4bb0] min-h-28 focus:outline-none" name="description" placeholder="description" required>${escapeHtml(project.description || '')}</textarea>
        <input class="rounded-xl p-3 bg-[#fb4bb0]" name="repository_url" value="${escapeHtml(project.repository_url || '')}" placeholder="repo link">
        <input class="rounded-xl p-3 bg-[#fb4bb0]" name="demo_url" value="${escapeHtml(project.demo_url || '')}" placeholder="demo link">
        <input class="rounded-xl p-3 bg-[#fb4bb0]" name="image_url" value="${escapeHtml(project.image_url || '')}" placeholder="image link">
        <div class="hackatime-editor rounded-xl p-3 bg-[#fb4bb0]">
          <p class="!m-0 mb-2">Hackatime project</p>
          <select class="rounded-xl p-3 bg-[#ff78cd] w-full" data-hackatime-select>
            <option value="">choose a Hackatime project</option>
          </select>
          <input type="hidden" name="hackatime_project" value="${escapeHtml(project.hackatime_project || '')}">
          <input type="hidden" name="hackatime_hours" value="${escapeHtml(project.hackatime_hours || '')}">
          <p class="hackatime-warning !m-0 mt-2 hidden"></p>
          <a class="hackatime-connect-link hidden inline-block rounded-xl p-2 bg-[#ff78cd] mt-2 no-underline">connect Hackatime</a>
        </div>
        <div class="flex flex-wrap gap-3">
          <button class="rounded-xl p-2 bg-[#fb4bb0]" type="submit">save</button>
          <button class="rounded-xl p-2 bg-[#fb4bb0]" type="button" data-ship-project="${project.id}">ship</button>
          <button class="rounded-xl p-2 bg-[#fb4bb0]" type="button" data-close-editor>close</button>
        </div>
      </form>
    `;
  }

  function renderProjects(projects) {
    if (!projects.length) {
      projectList.innerHTML = '<p>No projects yet.</p>';
      return;
    }

    projectList.innerHTML = '';
    projects.forEach((project) => {
      const article = document.createElement('article');
      article.className = 'bg-[#ff78cd] rounded-xl p-4 lift cursor-pointer';
      article.innerHTML = projectCard(project);
      article.addEventListener('click', () => {
        article.classList.remove('lift', 'cursor-pointer');
        article.innerHTML = editForm(project);
        setupHackatimeEditor(article, project);
        article.querySelector('.project-edit').addEventListener('submit', async (event) => {
          event.preventDefault();
          const payload = Object.fromEntries(new FormData(event.currentTarget).entries());
          try {
            await saveProject(project.id, payload);
            await loadProjects();
          } catch (error) {
            alert(error.message);
          }
        });
        article.querySelector('[data-ship-project]')?.addEventListener('click', async () => {
          const payload = Object.fromEntries(new FormData(article.querySelector('.project-edit')).entries());
          try {
            const updated = await saveProject(project.id, payload);
            await markPending(updated);
          } catch (error) {
            alert(error.message);
          }
        });
        article.querySelector('[data-close-editor]')?.addEventListener('click', () => renderProjects(projects));
      }, { once: true });
      projectList.appendChild(article);
    });
  }

  async function loadProjects() {
    const token = localStorage.getItem('token');
    const res = await fetch(`${API}/projects?token=${encodeURIComponent(token)}`);
    renderProjects(await res.json());
  }

  function setupHackatimeEditor(article, project) {
    const select = article.querySelector('[data-hackatime-select]');
    const projectInput = article.querySelector('input[name="hackatime_project"]');
    const hoursInput = article.querySelector('input[name="hackatime_hours"]');
    const warning = article.querySelector('.hackatime-warning');
    const connectLink = article.querySelector('.hackatime-connect-link');

    if (!hackatimeProjects.length) {
      warning.classList.remove('hidden');
      warning.textContent = hackatimeConnected
        ? 'Hackatime is linked, but the API did not return any projects with all-time hours yet.'
        : 'Link Hackatime to choose a project from the API.';
      if (!hackatimeConnected) {
        const token = localStorage.getItem('token');
        connectLink.href = `${API}/hackatime/connect?token=${encodeURIComponent(token)}`;
        connectLink.classList.remove('hidden');
      }
      if (project.hackatime_project) {
        const option = document.createElement('option');
        option.value = 'saved';
        option.textContent = `${project.hackatime_project}${project.hackatime_hours ? ` - ${project.hackatime_hours} hours` : ''}`;
        select.appendChild(option);
        select.value = 'saved';
      }
      return;
    }

    let selectedIndex = -1;
    hackatimeProjects.forEach((hackatimeProject, index) => {
      const option = document.createElement('option');
      option.value = String(index);
      option.textContent = hackatimeOptionLabel(hackatimeProject);
      select.appendChild(option);
      if (hackatimeProject.name === project.hackatime_project) selectedIndex = index;
    });

    if (selectedIndex >= 0) select.value = String(selectedIndex);

    select.addEventListener('change', () => {
      const selected = hackatimeProjects[Number(select.value)];
      projectInput.value = selected?.name || '';
      hoursInput.value = selected?.hours || '';
    });
  }

  user = await requireAuth();
  await loadHackatimeProjects();
  await loadProjects();
</script>
