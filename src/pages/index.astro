---
import '../../src/styles/global.css'
---
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Premiere</title>
		<body class="bg-[#234459] m-0 p-0">
		<img src="/banner_premiere.png" class=" w-screen hero-image">
		<img src="/premiere.png" class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 scale-50 transition 100 hover:scale-55">
		<div class="bg-[url(/blue.png)] w-screen bg-cover bg-bottom z-20 relative split">
		<p class="pt-30 pb-10 italic hover:underline">June 22nd - July 17th, for teens 18 and under</p>
		<p>We all know games you make disappear into the void, played by few then abandoned. <b class="!text-orange-400"> That ends today.</b></p>
		<p class="!text-3xl" >Ship <b class="!text-orange-400">a trailer</b> to <b class="!text-orange-400">your game</b> and we'll ship you x.</p>
		<p class="pb-80">this way, your game will reach more people & you'll get prizes for doing it.</p>

	</div>
	<div class="relative">
	<div class="bg-[url(/yellow.png)] w-screen bg-cover bg-bottom z-10 -top-130 absolute split">
		<h1 class="pt-130">How does premiere work?</h1>
		<p class="pb-15">keep track of your hours with <a href="https://hackatime.hackclub.com/">hackatime </a>and <a href="https://lapse.hackclub.com/">lapse.</a> Have questions? send them in #slack-channel.</p>
		<div class="flex flex-wrap items-center">
		<img class="w-1/4 transition-all duration-300 ease-in-out hover:rotate-6 hover:scale-110 hover:saturate-200" src="/card1.png" alt="build a game of your own, be creative!">
		<img class=" card w-1/4 transition-all duration-300 ease-in-out hover:-rotate-6 hover:scale-110 hover:saturate-200"src="/card2.png" alt="make a trailer to your game! screen record, animate, etc!">
		<img class="w-1/4 transition-all duration-300 ease-in-out hover:rotate-6 hover:scale-110 hover:saturate-200"src="/card3.png" alt="Publish to Itch.io, Github, and make social media posts!">
		<img class=" card w-1/4 transition-all duration-300 ease-in-out hover:-rotate-6 hover:scale-110 hover:saturate-200"src="/card4.png" alt="GET FREE STUFF!!!">
		</div>
		<p class="pb-100"></p>
	</div>
</div>
<div class="pt-240 bg-[#6d639c]">
	<div class="relative z-50 split">
	<h1>Prizes</h1>
	<p>prizes are determined by the quality of your game + trailer & the amount of hours you spent making them.</p>
	<p>image flexbox here... art max..</p>
	<p class="pb-80"></p>
	</div>
	<div class="bg-black w-screen pb-10 pt-10 z-30">
		<p><i>made with <3 by teenagers, for teenagers.</i></p>
		<p><a href="https://hackclub.com/">hack club</a> | <a href="https://hackclub.com/slack"> join our slack</a></p>
	</div>
	</body>
	<script>
		import { gsap } from "gsap";
		import { SplitText } from "gsap/SplitText";
		import { ScrollTrigger } from "gsap/ScrollTrigger";
		gsap.registerPlugin(SplitText, ScrollTrigger);
		const quotes = document.querySelectorAll(".split");
quotes.forEach((quote)=>{
	let split = SplitText.create(quote, { type: "words" });

gsap.from(split.words, {
	scrollTrigger: {
      trigger: quote,
      start: "top 80%", // Trigger when top of element hits 80% of viewport
      end: "bottom 60%",
      scrub: true, // Links animation to scrollbar
    },
  duration: 1, 
  y: 100,       
  autoAlpha: 0, // fade in from opacity: 0 and visibility: hidden
  stagger: 0.05
});
})
const cards = document.querySelectorAll('.card');
cards.forEach((card) => {
  gsap.fromTo(card,
    { y: 0 },
    {y: 75,
      scrollTrigger: {
        trigger: card,
        start: "top center",
        end: "+=200",
        scrub: 1
      }
    }
  );
});
	  </script>