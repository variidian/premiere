			<form action="https://forms.fillout.com/t/uAJgYAP9Ntus">
			<input class="rounded-full block absolute m-auto left-0 right-0 bg-[#f6f3e0] p-5 w-[35vw] form border-4 border-[#0c2639] focus:border-6 mt-20 z-6" type="text" name="email" placeholder="enter your email!">
			<div class="bg-[#25455d] rounded-full block absolute m-auto left-4 right-0 p-10 w-[35vw] mt-20 top-3 z-5 extend"></div>
			</form>
		</div>
		<p class="pb-120"></p>

	</div>
	<div class="relative">
	<div class=" bg-[url(/yellow.png)] w-screen h-[1894px] z-10 -top-130 absolute text-[#234459]">
		<h1 class="pt-160 z-30">How does premiere work?</h1>
		<p class="pb-15 move-down">keep track of your hours with <a href="https://hackatime.hackclub.com/">hackatime </a>and <a href="https://lapse.hackclub.com/">lapse.</a> Have questions? send them in #slack-channel.</p>
		<div class="flex flex-wrap items-center">
		<img class=" w-1/4 transition-all duration-300 ease-in-out hover:rotate-6 hover:scale-110 hover:saturate-200" src="/card1.png" alt="build a game of your own, be creative!">
		<img class=" card w-1/4 transition-all duration-300 ease-in-out hover:-rotate-6 hover:scale-110 hover:saturate-200"src="/card2.png" alt="make a trailer to your game! screen record, animate, etc!">
		<img class="  w-1/4 transition-all duration-300 ease-in-out hover:rotate-6 hover:scale-110 hover:saturate-200"src="/card3.png" alt="Publish to Itch.io, Github, and make social media posts!">
		<img class=" card w-1/4 transition-all duration-300 ease-in-out hover:-rotate-6 hover:scale-110 hover:saturate-200"src="/card4.png" alt="GET FREE STUFF!!!">
		</div>
		<p class="pb-125"></p>
	</div>
</div>
<div class="relative">
<div class="pt-360 bg-[url(/purpl.png)] w-screen bg-bottom absolute text-[#234459] z-5">
	<h1>Prizes</h1>
	<p class="z-50 pb-15 move-down">Prizes are mostly determined by the quality of your game + trailer, but how long you spent on each project also counts. Each project must have a minimum of 6h logged & started after June 22nd. The below are not the only prizes available, and you can get multiple if you spent long enough + have a high quality game!</p>
	<div class="flex overflow-hidden">
	<img class="float ml-10 rotate-10 w-1/4 h-1/4 scale-135 hover:saturate-200" src="/steam.png">
	<img class="float2 -rotate-5 w-1/4 h-1/4  hover:saturate-200" src="/godot.png">
	<img class="float w-1/4 h-1/4 rotate-10  hover:saturate-200" src="/cam.png">
	<img class="float2 w-1/4 h-1/4 -rotate-5  hover:saturate-200" src="/hegale.png">
	</div>
	<p class="pb-130"></p>
	</div>
</div>
<div class="relative">
<div class="bg-[url(/black.png)] absolute w-screen bg-bottom pb-10 pt-670 z-4 text-white">
	<h1>faq</h1>
	{AccordionItems.map((item) => (
		<Accordion
		question={item.question}
		answer={item.answer}
		/>
	   ))}
	<p class="pt-40"><i>made with <3 by teenagers, for teenagers.</i></p>
	<p><a href="https://hackclub.com/">hack club</a> | <a href="https://hackclub.com/slack"> join our slack</a></p>
</div>
</div>
	</body>
	<script>
		import { gsap } from "gsap";
		import { SplitText } from "gsap/SplitText";
		import { ScrollTrigger } from "gsap/ScrollTrigger";
		gsap.registerPlugin(SplitText, ScrollTrigger);
		const quotes = document.querySelectorAll(".split");
quotes.forEach((quote)=>{
	let split = SplitText.create(quote, { type: "words" });

	split.words.forEach((word) => {
	word.style.color = "#234459"; 
  });

gsap.from(split.words, {
	scrollTrigger: {
      trigger: quote,
      start: "top 80%", // Trigger when top of element hits 80% of viewport
      end: "bottom bottom",
      scrub: true, // Links animation to scrollbar
    },
  duration: 1, 
  y: 100,       
  autoAlpha: 0, // fade in from opacity: 0 and visibility: hidden
  stagger: 0.05
});
})
const cards = document.querySelectorAll('.card');
cards.forEach((card) => {
  gsap.fromTo(card,
    { y: 0 },
    {y: 75,
      scrollTrigger: {
        trigger: card,
        start: "top center",
        end: "+=200",
        scrub: 1
      }
    }
  );
});
const move = document.querySelectorAll('.move-down');
move.forEach((move)=> {
	gsap.fromTo(move,
	{ y: 0 },
	{ y: 50 ,
		scrollTrigger: {
        trigger: move,
        start: "top center",
        end: "+=200",
        scrub: 1
      }
	}
)
})
const float = document.querySelectorAll('.float');
float.forEach((floaty)=> {
	gsap.fromTo(floaty,
		{y: 0},
		{y: 50,
			repeat: -1,
			yoyo: true,
			duration: 2,
			ease: "none"
		}
	)
})
const float2 = document.querySelectorAll('.float2');
float2.forEach((floaty)=> {
	gsap.fromTo(floaty,
		{y: 50},
		{y: 0,
			repeat: -1,
			yoyo: true,
			ease: "none",
			duration: 2
		}
	)
})
const bgup = document.querySelectorAll('.bgup');
bgup.forEach((backgroundmovement)=>{
	gsap.fromTo(backgroundmovement,
		{y: 0},
		{y: -75, 
			repeat: -1,
			yoyo: true,
			ease: "none",
			duration: 5
      }
	)
})
const rsvp_form = document.querySelector(".form");
const extend = document.querySelector(".extend");
rsvp_form.addEventListener("focus", () => {
extend.style.top = "20px";
})
rsvp_form.addEventListener("blur", () => {
extend.style.top = "12px";
})
	  </script>