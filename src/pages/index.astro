---
import '../../src/styles/global.css'
import Accordion from '../components/accordion.astro'
const AccordionItems = [
	{
		question: "Can i use AI?",
		answer: "No art or music can be made with ai, and anything else it's used for is limited to being 20% of your project. You must also put a disclaimer in your repo with what components ai was used for."
	},
	{
		question: "Can i use resources i find online?",
		answer: "Sprite packs, music, etc. can be used, but make sure to credit them in your github repository. Please do not follow an exact tutorial to make x game, or it will be rejected."
	},
	{
		question: "Can beginners participate?",
		answer: "Of course! Beginners are heavily encouraged. Ask your questions in #premiere & we'll do our best to help! :] "
	},
	{
		question: "What do i make my game with?",
		answer: "For the development of your game, we reccommend tools like Godot & Unity, but any code-based software that allows web publishing and/or builds for Windows, Linux & Mac will work."
	},
	{
		question: "How do i make my trailer?",
		answer: "Your trailer should show players what makes your game unique and include interesting information about your game that compels them to try it, whether summarised simply with text or letting the game speak for itself. Maybe your game has interesting features or a unique game mechanic - Show that! "
	},
	{
		question: "How many art hours count?",
		answer: "40% of your total hours can be used towards making art for your game & making your trailer. Ex. if you've spent 2h on making sprites and 2h on making your trailer, you'll need to spend 6h on just coding your game."
	},
	{
		question: "I have another question!",
		answer: "Ask in #premiere!"
	}
]
---
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Premiere</title>
		<body class="bg-[#25455d] m-0 p-0">
		<img src="/banner_premiere4.png" class=" w-screen hero-image">
		<img src="/premiere.png" class="fixed scale-50 transition 100 hover:scale-70 top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2">
		<div class=" w-screen h-[1100px]  z-20 relative split">
		<img src="/blue.png" class="absolute w-screen h-full bgup bg-no-repeat s">
		<p class="pt-110 pb-10 italic">June 22nd - July 17th, for teens 18 and under</p>
		<p class="">We all know games you make disappear into the void, played by few then abandoned.<b>That ends today.</b></p>
		<p class="!text-3xl nono relative z-21">Ship <b>a trailer</b> to <b>your game</b> and we'll ship you <b class="prize"></b></p> 
		<p class="">this way, your game will reach more people & you'll get prizes for doing it.</p>
		<div class="relative">
			<form action="https://forms.fillout.com/t/uAJgYAP9Ntus">
			<input class="rounded-full block absolute m-auto left-0 right-0 bg-[#f6f3e0] p-5 w-[35vw] form border-4 border-[#0c2639] focus:border-6 mt-20 z-6" type="text" name="email" placeholder="enter your email!">
			<input class="rounded-full top-30 block absolute m-auto left-0 right-0 bg-[#f6f3e0] p-5 w-[10vw] form border-4 border-[#0c2639] hover:border-6 mt-20 z-6" type="submit">
			<div class="bg-[#25455d] rounded-full block absolute m-auto left-4 right-0 p-10 w-[35vw] mt-20 top-3 z-5 extend"></div>
			</form>
		</div>
		<p class="pb-120"></p>

	</div>
	<div class="relative w-screen">
	<div class=" bg-[url(/yellow.png)] w-screen bg-cover h-[1894px] z-10 -top-130 absolute bg-no-repeat bg-bottom text-[#000]">
		<h1 class="pt-160 z-30">How does premiere work?</h1>
		<p class="pb-15 move-down">keep track of your hours with <a href="https://hackatime.hackclub.com/">hackatime </a>and <a href="https://lapse.hackclub.com/">lapse.</a> Have questions? send them in #slack-channel.</p>
		<div class="flex flex-wrap items-center pr-30 pl-30">
		<img class=" w-1/4 transition-all duration-300 ease-in-out hover:rotate-6 hover:scale-110 hover:saturate-200" src="/card1.png" alt="build a game of your own, be creative!">
		<img class=" card w-1/4 transition-all duration-300 ease-in-out hover:-rotate-6 hover:scale-110 hover:saturate-200"src="/card2.png" alt="make a trailer to your game! screen record, animate, etc!">
		<img class="  w-1/4 transition-all duration-300 ease-in-out hover:rotate-6 hover:scale-110 hover:saturate-200"src="/card3.png" alt="Publish to Itch.io, Github, and make social media posts!">
		<img class=" card w-1/4 transition-all duration-300 ease-in-out hover:-rotate-6 hover:scale-110 hover:saturate-200"src="/card4.png" alt="GET FREE STUFF!!!">
	</div>
	</div>
</div>
<div class="relative">
<div class="pt-375 bg-[url(/purpl.png)] w-screen bg-cover bg-bottom absolute bg-no-repeat text-[#000] z-5 ">
	<h1>Prizes</h1>
	<p class="z-50 pb-30 move-down pr-30 pl-30">Prizes are mostly determined by the quality of your game + trailer, but how long you spent on each project also counts. Each project must have a minimum of 6h logged & started after June 22nd. The below are not the only prizes available, and you can get multiple if you spent long enough + have a high quality game!</p>
	<div class="flex overflow-hidden pb-10 pt-10 pr-30 pl-30">
		<img class="float rotate-10 w-1/5 h-1/5 scale-135 hover:saturate-200" src="/steam.png">
		<img class="float2 -rotate-5 w-1/5 h-1/5  hover:saturate-200" src="/godot.png">
		<img class="float w-1/5 h-1/5 rotate-10  hover:saturate-200" src="/cam.png">
		<img class="float2 w-1/5 h-1/5 -rotate-5  hover:saturate-200" src="/hegale.png">
		<img class="float w-1/5 h-1/5 rotate-10 hover:saturate-200" src="/adobe_premiere.png">
	</div>
	<p class="pb-130"></p>
	</div>
</div>
<div class="relative">
<div class="bg-[url(/black.png)] absolute bg-cover w-screen bg-bottom pb-10 pt-720 z-4 text-white bg-no-repeat">
	<h1>faq</h1>
	{AccordionItems.map((item) => (
		<Accordion
		question={item.question}
		answer={item.answer}
		/>
	   ))}
	<p class="pt-40"><i>made with <3 by teenagers, for teenagers.</i></p>
	<p><a href="https://hackclub.com/">hack club</a> | <a href="https://hackclub.com/slack"> join our slack</a></p>
</div>
</div>
	</body>
	<script>
		import { gsap } from "gsap";
		import { SplitText } from "gsap/SplitText";
		import { ScrollTrigger } from "gsap/ScrollTrigger";
		gsap.registerPlugin(SplitText, ScrollTrigger);
		const quotes = document.querySelectorAll(".split");
quotes.forEach((quote)=>{
	let split = SplitText.create(quote, { type: "words", ignore:".nono"});

	split.words.forEach((word) => {
	word.style.color = "#000"; 
  });

gsap.from(split.words, {
	scrollTrigger: {
      trigger: quote,
      start: "top 80%", // Trigger when top of element hits 80% of viewport
      end: "bottom bottom",
      scrub: true, // Links animation to scrollbar
    },
  duration: 1, 
  y: 100,       
  autoAlpha: 0, // fade in from opacity: 0 and visibility: hidden
  stagger: 0.05
});
})
const cards = document.querySelectorAll('.card');
cards.forEach((card) => {
  gsap.fromTo(card,
    { y: 0 },
    {y: 75,
      scrollTrigger: {
        trigger: card,
        start: "top center",
        end: "+=200",
        scrub: 1
      }
    }
  );
});
const move = document.querySelectorAll('.move-down');
move.forEach((move)=> {
	gsap.fromTo(move,
	{ y: 0 },
	{ y: 50 ,
		scrollTrigger: {
        trigger: move,
        start: "top center",
        end: "+=200",
        scrub: 1
      }
	}
)
})
const float = document.querySelectorAll('.float');
float.forEach((floaty)=> {
	gsap.fromTo(floaty,
		{y: 0},
		{y: 50,
			repeat: -1,
			yoyo: true,
			duration: 2,
			ease: "none"
		}
	)
})
const float2 = document.querySelectorAll('.float2');
float2.forEach((floaty)=> {
	gsap.fromTo(floaty,
		{y: 50},
		{y: 0,
			repeat: -1,
			yoyo: true,
			ease: "none",
			duration: 2
		}
	)
})
const bgup = document.querySelectorAll('.bgup');
bgup.forEach((backgroundmovement)=>{
	gsap.fromTo(backgroundmovement,
		{y: 0},
		{y: -75, 
			repeat: -1,
			yoyo: true,
			ease: "none",
			duration: 5
      }
	)
})
const rsvp_form = document.querySelector(".form");
const extend = document.querySelector(".extend");
rsvp_form.addEventListener("focus", () => {
extend.style.top = "20px";
})
rsvp_form.addEventListener("blur", () => {
extend.style.top = "12px";
})
const prizeText = document.querySelector(".prize");
const possiblePrizes = ["a camera","adobe premiere","videogames","a godot plushie","a steam publishing license"]
function changePrizeText() {
	let prize = possiblePrizes[Math.floor(Math.random() * possiblePrizes.length)];
	prizeText.innerHTML= `${prize}`;
}
changePrizeText();
setInterval(changePrizeText, 2000);
	  </script>