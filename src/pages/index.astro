---
import '../../src/styles/global.css'
import Accordion from '../components/accordion.astro'
const AccordionItems = [
	{
		question: "Can i use AI?",
		answer: "<p>Ai is limited to being 30% of your project, nor can you create assets nor write READMEs with it. You must also put a disclaimer in your repo with what components ai was used for. </p>"
	},
	{
		question: "Can i use resources i find online?",
		answer: "<p>Sprite packs, music, etc. can be used, but make sure to credit them in your github repository & that you have the appropriate license to use them. </p>"
	},
	{
		question: "Can beginners participate?",
		answer: "<p>Of course! Beginners are heavily encouraged. Ask your questions in #premiere & we'll do our best to help! :] "
	},
	{
		question: "What do i make my game with?",
		answer: "<p>For the development of your game, we recommend tools like Godot & Unity, but any code-based software that allows web publishing and/or builds for Windows, Linux & Mac will work.</p>"
	},
	{
		question: "How do i make my trailer?",
		answer: "<p>Your trailer should show players what makes your game unique and include interesting information about your game that compels them to try it, whether summarised simply with text or letting the game speak for itself. </p>"
	},
	{
		question: "I have another question!",
		answer: "<p>Ask in #premiere! </p>"
	}
]
---
<style>
	* {
    text-align: center;
}
</style>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Premiere</title>
		<body class="bg-[#3b41da] m-0 p-0">
		<img src="/banner_premiere4.png" class=" bg-screen hero-image">
		<img src="/premiere.png" class="fixed scale-50 transition 100 hover:scale-70 top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2">
		<div class=" w-screen h-[1100px] z-20 relative split">
		<img src="/blue.png" class="absolute w-screen h-full bgup bg-no-repeat s">
		<p class="pt-110 pb-10 italic">June 22nd - July 17th, for teens 18 and under</p>
		<p class="">We all know games you make disappear into the void, played by few then abandoned.<b>That ends today.</b></p>
		<p class="!text-3xl nono pop z-21">Ship <b>a trailer</b> to <b>your game</b> and we'll ship you <b class="prize"></b></p> 
		<p class="">this way, your game will reach more people & you'll get prizes for doing it.</p>
		<div class="relative">
			<button class="rounded-full top-30 block absolute m-auto left-0 right-0 bg-[#f6f3e0] p-5 w-80 form border-4 border-[#101250] hover:border-6 mt-20 z-6 text-2xl" id="login-btn">login with hackclub</button>
			<div class="bg-[#101250] rounded-full block absolute m-auto left-4 right-0 p-10 w-80 mt-50 top-3 z-5 extend"></div>
		</div>
		<p class="pb-120"></p>
	</div>
	<div class="relative w-screen">
	<div class=" bg-[url(/yellow.png)] w-screen h-[1894px] z-10 -top-130 absolute bg-no-repeat bg-bottom text-[#000] pr-10 pl-10">
		<h1 class="pt-160 z-30 mb-10">How does premiere work?</h1>
		<div class="flex flex-wrap items-center">
		<img class="w-1/2 md:w-1/4 transition-all duration-300 ease-in-out hover:rotate-6 hover:scale-110 hover:saturate-200" src="/card1.png" alt="build a game of your own, be creative!">
		<img class="w-1/2 card md:w-1/4 transition-all duration-300 ease-in-out hover:-rotate-6 hover:scale-110 hover:saturate-200"src="/card2.png" alt="make a trailer to your game! screen record, animate, etc!">
		<img class="w-1/2 md:w-1/4 transition-all duration-300 ease-in-out hover:rotate-6 hover:scale-110 hover:saturate-200"src="/card3.png" alt="Publish to Itch.io, Github, and make social media posts!">
		<img class="w-1/2 card md:w-1/4  transition-all duration-300 ease-in-out hover:-rotate-6 hover:scale-110 hover:saturate-200"src="/card4.png" alt="GET FREE STUFF!!!">
	</div>
	</div>
</div>
<div class="relative">
<div class="pt-375 bg-[url(/purpl.png)] bg-screen bg-bottom absolute bg-no-repeat text-[#000] z-5 ">
	<h1>Prizes</h1>
	<p class="z-50 pb-30 move-down pr-30 pl-30">Prizes are determined by both your project's quality and how long you spent on them. Log into the platform to view the whole selection available.</p>
	<div class="flex overflow-hidden pb-10 pt-10 pr-5 pl-5">
		<img class="float rotate-10 w-1/5 h-1/5 scale-135 hover:saturate-200" src="/steam.png">
		<img class="float2 -rotate-5 w-1/5 h-1/5  hover:saturate-200" src="/godot.png">
		<img class="float w-1/5 h-1/5 rotate-10  hover:saturate-200" src="/cam.png">
		<img class="float2 w-1/5 h-1/5 -rotate-5  hover:saturate-200" src="/hegale.png">
		<img class="float w-1/5 h-1/5 rotate-10 hover:saturate-200" src="/adobe_premiere.png">
	</div>
	<p class="pb-130"></p>
	</div>
</div>
<div class="relative">
<div class="bg-[url(/black.png)] absolute bg-screen bg-screen w-screen bg-bottom pb-10 pt-720 -top-40 z-4 text-white bg-no-repeat">
	<h1>Questions??!</h1>
	{AccordionItems.map((item) => (
		<Accordion
		question={item.question}
		answer={item.answer}
		/>
	   ))}
	<p class="pt-40"><i>made with <3 by teenagers, for teenagers.</i></p>
	<p><a href="https://hackclub.com/">hack club</a> | <a href="https://hackclub.com/slack"> join our slack</a></p>
</div>
</div>
	</body>
	<script>
		import { gsap } from "gsap";
		import { SplitText } from "gsap/SplitText";
		import { ScrollTrigger } from "gsap/ScrollTrigger";
		gsap.registerPlugin(SplitText, ScrollTrigger);
		const quotes = document.querySelectorAll(".split");
quotes.forEach((quote)=>{
	let split = SplitText.create(quote, { type: "words", ignore:".nono"});

	split.words.forEach((word) => {
	word.style.color = "#000"; 
  });

gsap.from(split.words, {
	scrollTrigger: {
      trigger: quote,
      start: "top 80%", // Trigger when top of element hits 80% of viewport
      end: "bottom bottom",
      scrub: true, // Links animation to scrollbar
    },
  duration: 1, 
  y: 100,       
  autoAlpha: 0, // fade in from opacity: 0 and visibility: hidden
  stagger: 0.05
});
})
const cards = document.querySelectorAll('.card');
cards.forEach((card) => {
  gsap.fromTo(card,
    { y: 0 },
    {y: 75,
      scrollTrigger: {
        trigger: card,
        start: "top center",
        end: "+=200",
        scrub: 1
      }
    }
  );
});
const move = document.querySelectorAll('.move-down');
move.forEach((move)=> {
	gsap.fromTo(move,
	{ y: 0 },
	{ y: 50 ,
		scrollTrigger: {
        trigger: move,
        start: "top center",
        end: "+=200",
        scrub: 1
      }
	}
)
})
const float = document.querySelectorAll('.float');
float.forEach((floaty)=> {
	gsap.fromTo(floaty,
		{y: 0},
		{y: 50,
			repeat: -1,
			yoyo: true,
			duration: 2,
			ease: "none"
		}
	)
})
const float2 = document.querySelectorAll('.float2');
float2.forEach((floaty)=> {
	gsap.fromTo(floaty,
		{y: 50},
		{y: 0,
			repeat: -1,
			yoyo: true,
			ease: "none",
			duration: 2
		}
	)
})
const bgup = document.querySelectorAll('.bgup');
bgup.forEach((backgroundmovement)=>{
	gsap.fromTo(backgroundmovement,
		{y: 0},
		{y: -75, 
			repeat: -1,
			yoyo: true,
			ease: "none",
			duration: 5
      }
	)
})
const rsvp_form = document.querySelector(".form");
const extend = document.querySelector(".extend");
rsvp_form.addEventListener("focus", () => {
extend.style.top = "20px";
})
rsvp_form.addEventListener("blur", () => {
extend.style.top = "12px";
})
const prizeText = document.querySelector(".prize");
const possiblePrizes = ["a camera","adobe premiere","videogames","a godot plushie","a steam publishing license"]

let lastAcceptedPrize
function changePrizeText() {
	let prize
	do {
    prize = possiblePrizes[Math.floor(Math.random() * possiblePrizes.length)];
} while (prize == lastAcceptedPrize);
	
	prizeText.innerHTML= `${prize}`;
	lastAcceptedPrize = prize
	gsap.from(".pop", {
  duration: 0.4,
  scale: 0.7,
  stagger: 0.1,
  ease: "back.out(3)"
});
return prize;
}

changePrizeText();
setInterval(changePrizeText, 2000);

const API = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000';
  document.getElementById('login-btn').addEventListener('click', () => {
    window.location.href = `${API}/auth/hackclub`;
  });

	  </script>