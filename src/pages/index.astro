---
import '../../src/styles/global.css'
---
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Premiere</title>
		<body class="bg-[#25455d] m-0 p-0">
		<img src="/banner_premiere4.png" class=" w-screen hero-image">
		<img src="/premiere.png" class="fixed scale-50 transition 100 hover:scale-70 top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2">
		<div class=" w-screen h-[1100px] overflow-hidden z-20 relative split">
		<img src="/blue.png" class="absolute top-0 left-0 w-full h-full object-cover bgup">
		<p class="pt-120 pb-10 italic">June 22nd - July 17th, for teens 18 and under</p>
		<p>We all know games you make disappear into the void, played by few then abandoned.  <b>That ends today.</b></p>
		<p class="!text-3xl" >Ship <b>a trailer</b> to <b>your game</b> and we'll ship you <b>a camera</b></p> 
		<p class="pb-120">this way, your game will reach more people & you'll get prizes for doing it.</p>

	</div>
	<div class="relative">
	<div class="bg-[url(/yellow.png)] w-screen bg-bottom z-10 -top-130 absolute text-[#234459]">
		<h1 class="pt-160">How does premiere work?</h1>
		<p class="pb-15 move-down">keep track of your hours with <a href="https://hackatime.hackclub.com/">hackatime </a>and <a href="https://lapse.hackclub.com/">lapse.</a> Have questions? send them in #slack-channel.</p>
		<div class="flex flex-wrap items-center">
		<img class="w-1/4 transition-all duration-300 ease-in-out hover:rotate-6 hover:scale-110 hover:saturate-200" src="/card1.png" alt="build a game of your own, be creative!">
		<img class=" card w-1/4 transition-all duration-300 ease-in-out hover:-rotate-6 hover:scale-110 hover:saturate-200"src="/card2.png" alt="make a trailer to your game! screen record, animate, etc!">
		<img class="w-1/4 transition-all duration-300 ease-in-out hover:rotate-6 hover:scale-110 hover:saturate-200"src="/card3.png" alt="Publish to Itch.io, Github, and make social media posts!">
		<img class=" card w-1/4 transition-all duration-300 ease-in-out hover:-rotate-6 hover:scale-110 hover:saturate-200"src="/card4.png" alt="GET FREE STUFF!!!">
		</div>
		<p class="pb-125"></p>
	</div>
</div>
<div class="relative">
<div class="pt-350 bg-[url(/purpl.png)] w-screen bg-bottom absolute text-[#234459] z-5">
	<h1 >Prizes</h1>
	<p class="pb-15 move-down">Prizes are determined by the quality of your game + trailer & how many hours you spent on them. The below are not the only prizes available!</p>
	<div class="flex overflow-hidden">
	<img class="float ml-10 rotate-10 w-1/4 h-1/4 scale-135 hover:saturate-200" src="/steam.png">
	<img class="float2 -rotate-5 w-1/4 h-1/4  hover:saturate-200" src="/godot.png">
	<img class="float w-1/4 h-1/4 rotate-10  hover:saturate-200" src="/cam.png">
	<img class="float2 w-1/4 h-1/4 -rotate-5  hover:saturate-200" src="/hegale.png">
	</div>
	<p class="pb-150"></p>
	</div>
</div>
<div class="relative">
<div class="bg-[url(/black.png)] absolute w-screen bg-bottom pb-10 pt-700 z-4 text-white">
	<p><i>made with <3 by teenagers, for teenagers.</i></p>
	<p><a href="https://hackclub.com/">hack club</a> | <a href="https://hackclub.com/slack"> join our slack</a></p>
</div>
</div>
	</body>
	<script>
		import { gsap } from "gsap";
		import { SplitText } from "gsap/SplitText";
		import { ScrollTrigger } from "gsap/ScrollTrigger";
		gsap.registerPlugin(SplitText, ScrollTrigger);
		const quotes = document.querySelectorAll(".split");
quotes.forEach((quote)=>{
	let split = SplitText.create(quote, { type: "words" });

	split.words.forEach((word) => {
	word.style.color = "#234459"; 
  });

gsap.from(split.words, {
	scrollTrigger: {
      trigger: quote,
      start: "top 80%", // Trigger when top of element hits 80% of viewport
      end: "bottom bottom",
      scrub: true, // Links animation to scrollbar
    },
  duration: 1, 
  y: 100,       
  autoAlpha: 0, // fade in from opacity: 0 and visibility: hidden
  stagger: 0.05
});
})
const cards = document.querySelectorAll('.card');
cards.forEach((card) => {
  gsap.fromTo(card,
    { y: 0 },
    {y: 75,
      scrollTrigger: {
        trigger: card,
        start: "top center",
        end: "+=200",
        scrub: 1
      }
    }
  );
});
const move = document.querySelectorAll('.move-down');
move.forEach((move)=> {
	gsap.fromTo(move,
	{ y: 0 },
	{ y: 50 ,
		scrollTrigger: {
        trigger: move,
        start: "top center",
        end: "+=200",
        scrub: 1
      }
	}
)
})
const float = document.querySelectorAll('.float');
float.forEach((floaty)=> {
	gsap.fromTo(floaty,
		{y: 0},
		{y: 50,
			repeat: -1,
			yoyo: true,
			duration: 2,
			ease: "none"
		}
	)
})
const float2 = document.querySelectorAll('.float2');
float2.forEach((floaty)=> {
	gsap.fromTo(floaty,
		{y: 50},
		{y: 0,
			repeat: -1,
			yoyo: true,
			ease: "none",
			duration: 2
		}
	)
})
const bgup = document.querySelectorAll('.bgup');
bgup.forEach((backgroundmovement)=>{
	gsap.fromTo(backgroundmovement,
		{y: 0},
		{y: -75, 
			scrollTrigger: {
		trigger: backgroundmovement.parentElement,
        start: "top center",
        end: "bottom top",
        scrub: 1
      }
		}
	)
})
	  </script>