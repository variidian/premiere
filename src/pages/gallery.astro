---
import '../../src/styles/global.css'
import '../../src/styles/platform.css'
import UserBar from '../components/user.astro'
---
<body class="bg-[url(/bg.png)] bg-fixed bg-center bg-no-repeat bg-cover ">
<!--navbar -->
    <div class=" left-0 top-0 fixed">
        <img src="navbar_.png" class="h-screen">
        <img src="stick.png" class="h-screen absolute top-0 left-1/2 -translate-x-1/2 z-[9] ">
        <div class="z-10 absolute top-0 left-0 right-0">
            <a href="/dash">
            <img src="home_d.png" class="min-w-full lift">
        </a>
            <a href="/projects">
            <img src="projects_d.png" class="min-w-full lift">
            </a>
            <a href="/gallery">
            <img src="gallery_l.png" class="min-w-full lift">
            </a>
            <a href="/shop">
            <img src="shop_d.png" class="min-w-full lift">
            </a>
            <a href="/refer">
            <img src="refer_d.png" class="min-w-full lift">
            </a>
        </div>
    </div>

<UserBar></UserBar>
<div class=" ml-[58.9vh] p-20 text-center max-w-full">
    <div class="overflow-hidden">
<!--may have to consider splitting projs across multiple pages to reduce loading time -->
<h1>Gallery</h1>
<p>Take a look at what other cool projects people have submitted to Premiere!</p>
</div>

<div id="gallery-projects" class="grid grid-cols-2 gap-6 mt-10"></div>
</div>
</body>

<script>
  import { API, requireAuth } from '../scripts/auth.js';

  const gallery = document.getElementById('gallery-projects');

  function escapeHtml(value = '') {
    return value.replace(/[&<>"']/g, (char) => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#39;'
    }[char]));
  }

  function renderProjects(projects) {
    if (!projects.length) {
      gallery.innerHTML = '<p>No submitted projects yet.</p>';
      return;
    }

    gallery.innerHTML = projects.map((project) => `
      <article class="bg-[#fb4bb0] rounded-xl p-5 lift">
        <div class="flex items-center gap-3 mb-3">
          ${project.author.avatar ? `<img src="${project.author.avatar}" class="w-12 h-12 rounded-full">` : ''}
          <p>${escapeHtml(project.author.display_name || 'Premiere maker')}</p>
        </div>
        <h2>${escapeHtml(project.name)}</h2>
        <p>Status: ${escapeHtml(project.status)}</p>
        <p>Hackatime: ${escapeHtml(project.hackatime_project)}</p>
        ${project.description ? `<p>${escapeHtml(project.description)}</p>` : ''}
        <div class="flex flex-wrap gap-3 mt-3">
          ${project.repository_url ? `<a href="${project.repository_url}" target="_blank" rel="noreferrer">repo</a>` : ''}
          ${project.demo_url ? `<a href="${project.demo_url}" target="_blank" rel="noreferrer">demo</a>` : ''}
        </div>
      </article>
    `).join('');
  }

  await requireAuth();
  const res = await fetch(`${API}/projects/accepted`);
  renderProjects(await res.json());
</script>
