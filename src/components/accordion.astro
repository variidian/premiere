---
interface Props {
    question : string;
    answer : string;
}
const {question, answer } = Astro.props
import '../../src/styles/global.css'
---
<button class="accordion"><p>{question}</p></button>
<div class="panel" set:html={answer}>
</div>
<style>
.accordion {
    width: 50vw;
    height: 40px;
    border-bottom: 2px solid #fff;
    
}
.small {
  font-size: smaller;
}
.panel {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.2s ease-out;
  width: 50vw;
  margin-left: auto;
  margin-right: auto;
  background-color: #10111d;
  border-bottom: 2px solid #fff;
}

</style>
<script>

    var acc = document.getElementsByClassName("accordion");
    var i;
    
    for (i = 0; i < acc.length; i++) { //loop thru

      acc[i].addEventListener("click", function() {
        this.classList.toggle("active"); //this = clicked accordion 
    
        var panel = this.nextElementSibling; //select the content panel

        if (panel.style.maxHeight) { //expand / collapse panel
          panel.style.maxHeight = null;
          this.style.background = "#000";
        } else {
          panel.style.maxHeight = panel.scrollHeight + "px";
          this.style.border = "0px solid";
          this.style.background = "#10111d";
        }

      });
    }
    </script>