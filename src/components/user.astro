<div class="bottom-5 right-5 p-5 fixed bg-[#ff78cd] flex w-[25vw] h-[16vh] rounded-3xl lift">
    <div class="h-full rounded-full overflow-hidden">
      <img src="" class="object-contain w-full h-full" id="pfp">
    </div>
    <div class="content-center text-center flex-1 text-[1.3vw]">
      <p id="username"></p>

      <div class="flex items-center">
        <p></p>
        <img src="clapperboard.svg" class="w-[1.3vw]">
        <p class="">1</p>
      </div>
    </div>
  </div>
  
  <script>
    import { getUser } from '../scripts/auth.js';
  
    //saves token from url after login
    const params = new URLSearchParams(window.location.search);
    if (params.get('token')) {
      localStorage.setItem('token', params.get('token'));
      window.history.replaceState({}, '', '/dash');
    }
  
    const user = await getUser();
    document.getElementById('pfp').src = user.avatar;
    document.getElementById('username').textContent = `@${user.display_name}`;
  
  </script>